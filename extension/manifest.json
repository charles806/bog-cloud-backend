{
  "manifest_version": 3,
  "name": "BOG Cloud Password Manager",
  "version": "1.0.0",
  "description": "Auto-fill and manage your passwords with BOG Cloud",
  "permissions": [
    "activeTab",
    "storage",
    "cookies",
    "identity"
  ],
  "host_permissions": [
    "http://localhost:5001/*",
    "https://*.bogcloud.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}